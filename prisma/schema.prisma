// Prisma Schema for TikTok Operations & Automation System
// Configured with PostgreSQL for Multi-User Realtime Cloud Sync

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// NextAuth OAuth Accounts
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

// NextAuth Sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth Verification Tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// 0. Groups / Teams
model Group {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  color       String?   @default("pink")
  leaderId    String?   @map("leader_id")
  leader      User?     @relation("GroupLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     User[]    @relation("GroupMembers")
  invitations Invitation[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leaderId])
  @@index([createdById])
  @@index([createdAt])
  @@map("groups")
}

// 1. Users / Staff / Operators / Admins
model User {
  id                String            @id @default(cuid())
  email             String            @unique
  emailVerified     DateTime?         @map("email_verified")
  name              String?
  fullName          String?
  image             String?
  password          String?
  firstName         String?           @map("first_name")
  lastName          String?           @map("last_name")
  username          String?           @unique
  avatar            String?
  phone             String?
  role              Role              @default(STAFF)
  isActive          Boolean           @default(true)
  isVerified        Boolean           @default(false)
  verificationLevel VerificationLevel @default(UNVERIFIED)
  lastActiveAt      DateTime?

  groupId           String?           @map("group_id")
  group             Group?            @relation("GroupMembers", fields: [groupId], references: [id], onDelete: SetNull)
  leadingGroups     Group[]           @relation("GroupLeader")
  createdGroups     Group[]           @relation("GroupCreator")

  accounts          Account[]
  sessions          Session[]
  tiktokAccounts    TiktokAccount[]
  dailyChecklists        DailyChecklist[]
  sentInvitations        Invitation[]             @relation("SentInvitations")
  extensionToken           String?                  @unique @map("extension_token")
  extensionAccessEnabled   Boolean                  @default(true) @map("extension_access_enabled")
  extensionRevokedAt       DateTime?                @map("extension_revoked_at")
  extensionSessionVersion  Int                      @default(0) @map("extension_session_version")
  extensionInstallations   ExtensionInstallation[]
  extensionRefreshTokens   ExtensionRefreshToken[]
  extensionPairingCodes    ExtensionPairingCode[]
  extensionAuthEvents      ExtensionAuthEvent[]

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  deletedAt              DateTime?                @map("deleted_at")

  @@index([deletedAt])
  @@index([isActive])
  @@index([role])
  @@index([groupId])
  @@index([createdAt])
  @@index([deletedAt, isActive])
  @@index([deletedAt, role])
  @@map("users")
}

// 2. TikTok Accounts Fleet
model TiktokAccount {
  id                 String               @id @default(cuid())
  username           String               @unique
  country            String               @default("US") // US, UK, VN, DE, FR...
  gpmProfileId       String?              // GPM-Login profile UUID
  groupName          String?              // Raw GPM group / tag
  status             AccountStatus        @default(ACTIVE)
  assignedUserId     String?
  assignedUser       User?                @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  isAssignmentLocked Boolean              @default(false) @map("is_assignment_locked") // Khóa phân công: chỉ Admin mới đổi được
  totalViews         BigInt               @default(0)
  totalFollowers     Int                  @default(0)
  totalVideos        Int                  @default(0)
  totalRevenue       Decimal              @default(0.0) @db.Decimal(12, 2)
  lastSyncedAt       DateTime?
  alerts             AccountAlert[]
  logs               AccountLog[]
  dailyRevenues      DailyRevenue[]
  checklistItems     DailyChecklistItem[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status])
  @@index([assignedUserId])
  @@index([country])
  @@index([gpmProfileId])
  @@index([groupName])
  @@index([updatedAt])
  @@index([createdAt])
  @@index([assignedUserId, status])
  @@index([totalRevenue(sort: Desc)])
  @@index([totalViews(sort: Desc)])
  @@map("tiktok_accounts")
}

// 3. Audit Trail & Status Changes
model AccountLog {
  id        String        @id @default(cuid())
  accountId String
  account   TiktokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  oldStatus String?
  newStatus String
  logType   String        // STATUS_CHANGE, SYNC_ERROR, REVENUE_UPDATE, ALERT
  message   String
  actorName String        @default("System")
  createdAt DateTime      @default(now())

  @@index([accountId])
  @@index([accountId, createdAt])
  @@index([createdAt])
  @@map("account_logs")
}

// 4. Risk & Health Alerts
model AccountAlert {
  id          String        @id @default(cuid())
  accountId   String
  account     TiktokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  alertType   String        // PROGRAM_DISQUALIFIED, VIDEO_STRIKE, LOW_QUALITY, CHECKPOINT, NOT_LOGGED_IN
  severity    AlertSeverity @default(WARNING)
  description String
  status      AlertStatus   @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([accountId])
  @@index([status])
  @@index([accountId, status])
  @@index([status, severity])
  @@index([createdAt])
  @@map("account_alerts")
}

// 5. Daily Workday & KPI Checklist
model DailyChecklist {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime             @db.Date
  totalAssigned  Int                  @default(0)
  completedCount Int                  @default(0)
  completionRate Decimal              @default(0.0) @db.Decimal(5, 2) // 0 - 100%
  workdayScore   Decimal              @default(0.0) @db.Decimal(3, 2) // 1.0, 0.5, 0.0
  isLocked       Boolean              @default(false)
  lockedAt       DateTime?
  items          DailyChecklistItem[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([date, workdayScore])
  @@index([userId, isLocked])
  @@map("daily_checklists")
}

model DailyChecklistItem {
  id          String         @id @default(cuid())
  checklistId String
  checklist   DailyChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  accountId   String
  account     TiktokAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  isPosted    Boolean        @default(false)
  isSynced    Boolean        @default(false)
  isCompleted Boolean        @default(false)
  notes       String?
  updatedAt   DateTime       @updatedAt

  @@index([checklistId])
  @@index([accountId])
  @@index([checklistId, isCompleted])
  @@index([checklistId, isPosted])
  @@index([checklistId, isSynced])
  @@map("daily_checklist_items")
}

// 6. Daily Revenue & RPM Records
model DailyRevenue {
  id         String        @id @default(cuid())
  accountId  String
  account    TiktokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date       DateTime      @db.Date
  views      BigInt        @default(0)
  rpm        Decimal       @default(0.0) @db.Decimal(6, 3)
  revenue    Decimal       @default(0.0) @db.Decimal(10, 2)
  sourceType String        @default("CREATOR_REWARDS") // CREATOR_REWARDS, AFFILIATE, SERIES
  createdAt  DateTime      @default(now())

  @@unique([accountId, date, sourceType])
  @@index([date])
  @@index([accountId, date])
  @@index([date, revenue])
  @@map("daily_revenues")
}

// 7. Dynamic System Configurations
model SystemConfig {
  key         String   @id
  value       String   @db.Text // JSON stringified config
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

// 8. Team / Workspace Member Invitations
model Invitation {
  id          String           @id @default(cuid())
  email       String
  role        Role             @default(STAFF)
  groupId     String?          @map("group_id")
  group       Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  invitedById String           @map("invited_by_id")
  invitedBy   User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([email])
  @@index([token])
  @@index([status])
  @@index([groupId])
  @@index([invitedById])
  @@index([expiresAt])
  @@map("invitations")
}

// 7. Extensions Registry & Companion Hub
model Extension {
  id                String                  @id @default(cuid())
  slug              String                  @unique // e.g. "tiktokflow-companion"
  name              String                  // "TikTokFlow Companion"
  version           String                  @default("1.0.0")
  description       String?                 @db.Text
  shortDesc         String?                 @map("short_desc")
  category          String                  @default("AUTOMATION") // AUTOMATION, ANALYTICS, SCRAPER, UTILITY
  iconUrl           String?                 @map("icon_url")
  downloadUrl       String?                 @map("download_url")
  folderPath        String?                 @default("extension") @map("folder_path")
  changelog         String?                 @db.Text
  permissions       String[]                @default([])
  supportedBrowsers String[]                @default(["Chrome", "Edge", "Brave"]) @map("supported_browsers")
  isActive          Boolean                 @default(true) @map("is_active")
  isFeatured        Boolean                 @default(false) @map("is_featured")
  minAppVersion     String?                 @map("min_app_version")
  author            String                  @default("TikTokFlow Team")
  installations     ExtensionInstallation[]

  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([createdAt])
  @@index([name])
  @@map("extensions")
}

model ExtensionInstallation {
  id               String    @id @default(cuid())
  extensionId      String    @map("extension_id")
  extension        Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  installedVersion String    @default("1.0.0") @map("installed_version")
  browserName      String?   @map("browser_name")
  lastPingAt       DateTime? @map("last_ping_at")
  status           String    @default("ACTIVE") // ACTIVE, OUTDATED, INACTIVE

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([extensionId, userId])
  @@index([userId])
  @@index([extensionId])
  @@map("extension_installations")
}

enum Role {
  ADMIN
  LEAD
  STAFF
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AccountStatus {
  ACTIVE
  WARMING
  RESTRICTED
  BANNED
  STOPPED
  CUSTOM
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum VerificationLevel {
  UNVERIFIED
  EMAIL_VERIFIED
  PHONE_VERIFIED
  IDENTITY_VERIFIED
  BUSINESS_VERIFIED
  PREMIUM_VERIFIED
}

// Extension / Client Agent short-lived session refresh tokens (hashed at rest)
model ExtensionRefreshToken {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique @map("token_hash")
  familyId         String    @map("family_id")
  replacedById     String?   @map("replaced_by_id")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  issuedUserAgent  String?   @map("issued_user_agent") @db.VarChar(200)
  issuedIp         String?   @map("issued_ip") @db.VarChar(64)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("extension_refresh_tokens")
}

// One-time pairing codes embedded in download zips (hashed at rest)
model ExtensionPairingCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("extension_pairing_codes")
}

// Durable extension auth incidents (no secrets)
model ExtensionAuthEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String   @map("event_type")
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(200)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("extension_auth_events")
}

